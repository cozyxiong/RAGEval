# Judge LLM (OpenAI-compatible). Leave OPENAI_API_KEY empty to use heuristic Judge.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4.1-mini

# Optional override. Default is ./data/eval.db
# EVAL_DB_PATH=./data/eval.db

# BaGuLLM adapter (python -m adapters.bagullm  →  :8101)
BAGULLM_BASE_URL=http://127.0.0.1:3001
BAGULLM_API_KEY=
BAGULLM_WORKSPACE=java
BAGULLM_CHAT_MODE=query
# plain = send the query as-is. closed-refuse-v2 = closed-domain refuse/clarify wrapper (one rag_version.prompt change).
BAGULLM_PROMPT_PROFILE=plain
